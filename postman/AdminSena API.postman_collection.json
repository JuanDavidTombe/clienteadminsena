{
  "info": {
    "name": "AdminSena API",
    "description": "Coleccion GET para la API de AdminSena. Base: {{baseUrl}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://api.adminsena.test/v1",
      "type": "string"
    }
  ],
  "item": [
