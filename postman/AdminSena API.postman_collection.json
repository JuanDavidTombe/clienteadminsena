      "name": "Areas",
      "item": [
        {
          "name": "Listar areas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/areas", "host": ["{{baseUrl}}"], "path": ["areas"] }
          }
        },
        {
          "name": "Ver area",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/areas/1", "host": ["{{baseUrl}}"], "path": ["areas", "1"] }
          }
